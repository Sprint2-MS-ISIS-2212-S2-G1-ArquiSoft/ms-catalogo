# Aplicacion
NODE_ENV=development
PORT=3000
CATALOGO_NAME=catalogo

# BD Catalogo (PostgreSQL). DB_PORT=5434 es el puerto publicado por
# docker-compose.local.yml hacia el host; dentro de la red de compose es 5432.
DB_HOST=localhost
DB_PORT=5434
DB_USER=catalogo
DB_PASSWORD=catalogo
DB_NAME=catalogo

# Muestra las consultas SQL en consola.
DB_LOGGING=false
